{
  "name": "salonbook-server",
  "version": "1.0.0",
  "private": true,
  "description": "SalonBook modular Express, TypeScript and MongoDB API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed:catalog": "node dist/bootstrap.js catalog",
    "bootstrap:admin": "node dist/bootstrap.js admin",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.27",
    "better-auth": "1.7.27",
    "better-call": "1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "6.2.18",
    "mongoose": "^8.19.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "5.1.1"
  }
}
